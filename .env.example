# Copy to .env and fill in. .env is gitignored — never commit real values.
# (Only needed for the LIVE build. The demo build ignores all of these.)

# Supabase project — the publishable/anon key is a client key (safe with RLS).
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-publishable-key

# Who may sign in, and as admin or viewer, is the app_users table in Supabase,
# not a setting here. Add someone with:
#   INSERT INTO app_users (email, role) VALUES ('name@company.com', 'viewer');
#
# Every REACT_APP_* value in this file is built into the public JavaScript
# (a library reads process.env whole), whether the code uses it or not.
# Never put a secret or a list of personal emails here.
