# Copy to .env and fill in. .env is gitignored — never commit real values.
# (Only needed for the LIVE build. The demo build ignores all of these.)

# Supabase project — the publishable/anon key is a client key (safe with RLS).
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-publishable-key

# Role allowlist — comma-separated emails, kept out of source control.
# This is a UI/UX gate only; real access is enforced by Supabase RLS.
REACT_APP_ADMIN_EMAILS=admin1@example.com,admin2@example.com
REACT_APP_VIEWER_EMAILS=viewer1@example.com,viewer2@example.com
